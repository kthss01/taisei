msgid "Character Profiles"
msgstr "캐릭터 프로필"

#: src/menu/charprofile.c:272
msgid "Press [Fire] for alternate expressions"
msgstr "[Fire]를 누르면 다른 표정을 볼 수 있습니다"

#: src/menu/charselect.c:170
msgid "Intuition"
msgstr "직관"

#: src/menu/charselect.c:171
msgid "Science"
msgstr "과학"

#: src/menu/charselect.c:178
msgid "Select Character"
msgstr "캐릭터 선택"

#: src/menu/cutsceneview.c:23
msgid "Cutscene Viewer"
msgstr "컷신 뷰어"

#: src/menu/cutsceneview.c:49
msgid "(Locked)"
msgstr "(잠김)"

#: src/menu/difficultyselect.c:44
msgid ""
"For those just beginning\n"
"their academic careers"
msgstr ""
"학자의 길을\n"
"막 걷기 시작한 분께"

#: src/menu/difficultyselect.c:46
msgid ""
"All those years of study\n"
